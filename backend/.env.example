# backend/.env.example
# 실제 값을 채운 뒤 backend/.env 로 복사해서 사용하세요. (.env는 git에 커밋하지 마세요)
#
# Spring Boot는 기본적으로 .env 파일을 자동으로 읽지 않습니다.
# 아래 변수들은 실행 전에 OS 환경변수로 export 하거나, IDE(예: IntelliJ) 실행 설정의
# Environment Variables에 등록하거나, `env $(cat .env | xargs) ./mvnw spring-boot:run` 같은
# 방식으로 주입해서 사용하세요.

## DB (필수)
DB_HOST=localhost
DB_NAME=smconsole
DB_USER=root
DB_PASSWORD=

## OpenAI - AuditLogAnalyzePage의 AI 분석 기능에 사용 (필수)
OPENAI_API_KEY=

## Slack - 장애/인시던트 알림 webhook (선택, 비워두면 알림 비활성)
SLACK_WEBHOOK_URL=

## 외부 모니터링 시스템이 POST /api/incidents/webhook 호출 시 X-Webhook-Secret 헤더로 보내야 하는 값 (필수)
## 비워두면 이 엔드포인트는 어떤 요청도 401로 거부합니다 (fail-closed).
INCIDENT_WEBHOOK_SECRET=
